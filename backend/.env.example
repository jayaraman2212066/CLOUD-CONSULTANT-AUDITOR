# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string
DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/postgres?sslmode=require

# ── Polar.sh ──────────────────────────────────────────────────────────────────
POLAR_ACCESS_TOKEN=<your_polar_access_token>
POLAR_ORGANIZATION_ID=<your_polar_organization_id>
POLAR_WEBHOOK_SECRET=<your_polar_webhook_secret>

# Polar Product IDs (from your Polar dashboard)
POLAR_PRODUCT_ID_FREELANCER=<your_freelancer_product_id>
POLAR_PRODUCT_ID_CONSULTANT_PRO=<your_consultant_pro_product_id>
POLAR_PRODUCT_ID_PAY_PER_REPORT=<your_pay_per_report_product_id>

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:8000,http://127.0.0.1:8000
# Production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── App ───────────────────────────────────────────────────────────────────────
MAX_JSON_MB=500          # Upload limit for paid users (MB)
MAX_JSON_MB_FREE=50      # Upload limit for free tier (MB)
FREE_TIER_LIMIT=3
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=<generate_a_random_64_char_hex_string>
